<!DOCTYPE html>
<html>
  <head>
    <title><%= content_for(:title) || "Webtech Roomies" %></title>
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <meta name="apple-mobile-web-app-capable" content="yes">
    <meta name="application-name" content="Webtech Roomies">
    <meta name="mobile-web-app-capable" content="yes">
    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>

    <%= yield :head %>

    <link rel="icon" href="/icon.png" type="image/png">
    <link rel="icon" href="/icon.svg" type="image/svg+xml">
    <link rel="apple-touch-icon" href="/icon.png">
    <%= stylesheet_link_tag :app, "data-turbo-track": "reload" %>
    <link rel="stylesheet" href="https://unpkg.com/trix@2.0.8/dist/trix.css">
<script type="importmap">
  {
    "imports": {
      "trix": "https://ga.jspm.io/npm:trix@2.0.8/dist/trix.esm.js",
      "@rails/actiontext": "https://cdn.jsdelivr.net/npm/@rails/actiontext@7.2.0/app/assets/javascripts/actiontext.esm.js"
    }
  }
</script>
    <%= javascript_importmap_tags %>
  </head>

  <body class="d-flex flex-column min-vh-100">
    <header>
      <nav class="navbar navbar-expand bg-light border-bottom">
        <div class="container flex-wrap gap-2">
          <%= link_to "Roomies", root_path, class: "navbar-brand" %>

          <ul class="navbar-nav flex-row flex-wrap gap-3 ms-auto align-items-center">
            <li class="nav-item">
              <%= link_to "Search", listings_path, class: "nav-link" %>
            </li>
            <li class="nav-item">
              <%= link_to "Properties", properties_path, class: "nav-link" %>
            </li>
            <% if authenticated? %>
              <li class="nav-item">
                <%= link_to "Applications", applications_path, class: "nav-link" %>
              </li>
              <% display_name = Current.user.full_name.presence || Current.user.email_address %>
              <li class="nav-item">
                <%= link_to display_name, edit_profile_path, class: "nav-link" %>
              </li>
              <li class="nav-item">
                <%= button_to "Sign out", session_path, method: :delete,
                      class: "btn btn-outline-secondary btn-sm", form: { class: "d-inline" } %>
              </li>
            <% else %>
              <li class="nav-item">
                <%= link_to "Sign in", new_session_path, class: "nav-link" %>
              </li>
              <li class="nav-item">
                <%= link_to "Sign up", new_user_path, class: "btn btn-primary btn-sm" %>
              </li>
            <% end %>
          </ul>

        </div>
      </nav>
    </header>

    <main class="flex-grow-1">
      <div class="container mt-3" id="flash">
        <%= render "shared/flash" %>
      </div>

      <%= yield %>
    </main>

    <footer class="bg-light border-top py-4 mt-5">
      <div class="container text-center">
        <p class="mb-1">
          Team: Teodoro Coz, Matias Küpfer, Arantxa Toledo
        </p>
        <p class="mb-0">Web Technologies 2026</p>
      </div>
    </footer>
  </body>
</html>