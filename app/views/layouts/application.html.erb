<!DOCTYPE html>
<html>
  <head>
    <title><%= content_for(:title) || "Webtech Roomies" %></title>
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <meta name="apple-mobile-web-app-capable" content="yes">
    <meta name="application-name" content="Webtech Roomies">
    <meta name="mobile-web-app-capable" content="yes">
    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>

    <%= yield :head %>

    

    <link rel="icon" href="/icon.png" type="image/png">
    <link rel="icon" href="/icon.svg" type="image/svg+xml">
    <link rel="apple-touch-icon" href="/icon.png">
    <%= stylesheet_link_tag :app, "data-turbo-track": "reload" %>
    
    
    <%= stylesheet_link_tag "actiontext", "data-turbo-track": "reload" %>

    <%= javascript_importmap_tags %>
  </head>

  <body class="d-flex flex-column min-vh-100">
    <header>
      <nav class="navbar navbar-expand bg-light border-bottom">
        <div class="container flex-wrap gap-2">
          <%= link_to "Roomies", root_path, class: "navbar-brand" %>

          <ul class="navbar-nav flex-row flex-wrap gap-3">
            <li class="nav-item">
              <%= link_to "Search", listings_path, class: "nav-link" %>
            </li>
            <li class="nav-item">
              <%= link_to "Properties", properties_path, class: "nav-link" %>
            </li>
            <li class="nav-item">
              <%= link_to "Neighborhoods", neighborhoods_path, class: "nav-link" %>
            </li>
            <li class="nav-item">
              <%= link_to "Amenities", amenities_path, class: "nav-link" %>
            </li>
          </ul>
          <%= form_with url: current_user_path, method: :patch, class: "d-flex gap-2" do %>
            <%= select_tag :user_id,
                  options_from_collection_for_select(User.order(:full_name), :id, :full_name, current_user&.id),
                  class: "form-select",
                  aria: { label: "Acting as" } %>
            <%= submit_tag "Switch user", class: "btn btn-outline-primary" %>
          <% end %>
        </div>
      </nav>
    </header>

    <main class="flex-grow-1">
      <div class="container mt-3">
        <% flash.each do |key, message| %>
          <% alert_class = (key.to_s.in?(%w[notice success])) ? "alert-success" : "alert-danger" %>
          <div class="alert <%= alert_class %> alert-dismissible fade show" role="alert">
            <%= message %>
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
          </div>
        <% end %>
      </div>

      <%= yield %>
    </main>

    <footer class="bg-light border-top py-4 mt-5">
      <div class="container text-center">
        <p class="mb-1">
          Team: Teodoro Coz, Matias Küpfer, Arantxa Toledo
        </p>
        <p class="mb-0">Web Technologies 2026</p>
      </div>
    </footer>
  </body>
</html>