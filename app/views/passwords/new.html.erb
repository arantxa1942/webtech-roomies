<div class="row justify-content-center mt-5">
  <div class="col-md-5">
    <div class="card shadow-sm">
      <div class="card-body p-4">
        <h1 class="h3 mb-4 fw-normal text-center">Forgot your password?</h1>

        <%= form_with url: passwords_path do |form| %>
          <div class="mb-3">
            <%= form.label :email_address, class: "form-label" %>
            <%= form.email_field :email_address, required: true, autofocus: true, autocomplete: "email", placeholder: "enter your email", class: "form-control" %>
          </div>

          <div class="mb-3 d-grid">
            <%= form.submit "Send reset instructions", class: "btn btn-primary" %>
          </div>
        <% end %>

        <div class="text-center mt-3">
          <%= link_to "Back to sign in", new_session_path, class: "text-decoration-none" %>
        </div>
      </div>
    </div>
  </div>
</div>