<div class="row justify-content-center mt-5">
  <div class="col-md-5">
    <div class="card shadow-sm">
      <div class="card-body p-4">
        <h1 class="h3 mb-4 fw-normal text-center">New password</h1>

        <%= form_with url: password_path(params[:token]), method: :patch do |form| %>
          <div class="mb-3">
            <%= form.label :password, "New password", class: "form-label" %>
            <%= form.password_field :password, required: true, autocomplete: "new-password", placeholder: "new password", maxlength: 72, class: "form-control" %>
          </div>

          <div class="mb-3">
            <%= form.label :password_confirmation, "Confirm new password", class: "form-label" %>
            <%= form.password_field :password_confirmation, required: true, autocomplete: "new-password", placeholder: "confirm password", maxlength: 72, class: "form-control" %>
          </div>

          <div class="mb-3 d-grid">
            <%= form.submit "Save new password", class: "btn btn-primary" %>
          </div>
        <% end %>
      </div>
    </div>
  </div>
</div>