<div class="row justify-content-center mt-5">
  <div class="col-md-6">
    <div class="card shadow-sm">
      <div class="card-body p-4">
        <h1 class="h3 mb-4 fw-normal text-center">Edit profile</h1>

        <%= form_with model: current_user, url: profile_path, method: :patch do |form| %>
          <% if current_user.errors.any? %>
            <div class="alert alert-danger">
              <ul class="mb-0">
                <% current_user.errors.full_messages.each do |message| %>
                  <li><%= message %></li>
                <% end %>
              </ul>
            </div>
          <% end %>

            <div class="mb-3">
            <%= form.label :full_name, "Name", class: "form-label" %>
            <%= form.text_field :full_name, class: "form-control" %>
            </div>

          <div class="mb-3">
            <%= form.label :contact_details, class: "form-label" %>
            <%= form.text_area :contact_details, class: "form-control", rows: 2 %>
          </div>

          <div class="mb-3">
            <%= form.label :bio, class: "form-label" %>
            <%= form.text_area :bio, class: "form-control", rows: 3 %>
          </div>

          <div class="mb-3 d-grid">
            <%= form.submit "Save changes", class: "btn btn-primary" %>
          </div>
        <% end %>
      </div>
    </div>
  </div>
</div>