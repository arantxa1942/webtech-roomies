<div class="container py-4">
  <div class="d-flex justify-content-between align-items-start">
    <div>
      <h1><%= @amenity.name %></h1>
      <p>Category: <%= @amenity.category %></p>
    </div>

    <% if policy(@amenity).update? %>
      <div class="d-flex gap-2">
        <%= link_to "Edit", edit_amenity_path(@amenity), class: "btn btn-warning" %>
        <% if policy(@amenity).destroy? %>
          <%= button_to "Delete",
                amenity_path(@amenity),
                method: :delete,
                class: "btn btn-danger",
                form: { data: { turbo_confirm: "Delete this amenity?" } } %>
        <% end %>
      </div>
    <% end %>
  </div>

  <h2 class="h4 mt-4">Properties with this amenity</h2>

  <% if @properties.empty? %>
    <p>No properties use this amenity yet.</p>
  <% else %>
    <ul class="list-group mb-4">
      <% @properties.each do |property| %>
        <li class="list-group-item">
          <%= link_to property.title, property_path(property) %>
        </li>
      <% end %>
    </ul>
  <% end %>

  <%= link_to "Back to amenities", amenities_path, class: "btn btn-outline-secondary" %>
</div>