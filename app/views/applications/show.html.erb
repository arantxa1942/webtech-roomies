<div class="container py-4">
    <h1>Application details</h1>

    <p>Applicant: <%= @application.applicant.full_name %></p>

    <p>
        Listing:
        <%= link_to @application.listing.title, listing_path(@application.listing) %>
    </p>

    <p>Status: <%= @application.status.humanize %></p>
    <p>Submitted at: <%= @application.created_at %></p>

        <h2 class="h4">Visit</h2>

    <% is_host = @application.listing.property.owner_id == current_user&.id %>

    <% if @visit.present? %>
      <p>Scheduled at: <%= l(@visit.scheduled_at, format: :long) %></p>
      <p>Status: <%= @visit.status.humanize %></p>
      <p><%= @visit.notes %></p>

      <% if is_host %>
        <% if @visit.proposed? || @visit.confirmed? %>
          <%= render "visits/form",
                visit: @visit,
                application: @application %>
        <% end %>

        <% if @visit.proposed? %>
          <%= button_to "Confirm visit",
                confirm_application_visit_path(@application),
                method: :patch,
                class: "btn btn-success" %>
        <% end %>

        <% if @visit.proposed? || @visit.confirmed? %>
          <%= button_to "Cancel visit",
                cancel_application_visit_path(@application),
                method: :patch,
                class: "btn btn-outline-danger",
                form: { data: { turbo_confirm: "Cancel this visit?" } } %>
        <% end %>

        <% if @visit.confirmed? %>
          <%= button_to "Mark as completed",
                complete_application_visit_path(@application),
                method: :patch,
                class: "btn btn-primary" %>
        <% end %>
      <% end %>

    <% elsif is_host && @application.shortlisted? %>
      <%= render "visits/form",
            visit: Visit.new,
            application: @application %>

    <% elsif !is_host %>
      <p>No visit has been scheduled.</p>
    <% end %>
    <%= render "visits/form",
      visit: @visit || Visit.new,
      application: @application %>
    <%= link_to "Back to applications", applications_path, class: "btn btn-outline-primary" %>
</div>