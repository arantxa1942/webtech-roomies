<div class="container py-4">
    <h1>Applications</h1>

    <% if @applications.empty? %>
        <p>No applications available.</p>
    <% else %>
        <div class="table-responsive">
            <table class="table">
                <thead>
                    <tr>
                        <th scope="col">Applicant</th>
                        <th scope="col">Listing</th>
                        <th scope="col">Status</th>
                        <th scope="col">Details</th>
                    </tr>
                </thead>

                <tbody>
                    <% @applications.each do |application| %>
                        <tr>
                            <td><%= application.applicant.full_name %></td>
                            <td><%= link_to application.listing.title, listing_path(application.listing) %></td>
                            <td><%= application.status.humanize %></td>
                            <td><%= link_to "View application", application_path(application) %></td>
                        </tr>
                    <% end %>
                </tbody>
            </table>
        </div>
    <% end %>
</div>