<div class="container py-4">
  <div class="d-flex justify-content-between align-items-start">
    <div>
      <h1><%= @neighborhood.name %></h1>
      <p>City: <%= @neighborhood.city %></p>
    </div>

    <div class="d-flex gap-2">
      <%= link_to "Edit", edit_neighborhood_path(@neighborhood),
            class: "btn btn-warning" %>
      <%= button_to "Delete",
            neighborhood_path(@neighborhood),
            method: :delete,
            class: "btn btn-danger",
            form: { data: { turbo_confirm: "Delete this neighborhood?" } } %>
    </div>
  </div>

  <h2 class="h4 mt-4">Properties</h2>

  <% if @properties.empty? %>
    <p>No properties in this neighborhood.</p>
  <% else %>
    <ul class="list-group mb-4">
      <% @properties.each do |property| %>
        <li class="list-group-item">
          <%= link_to property.title, property_path(property) %>
          <p class="mb-0"><%= property.address %></p>
        </li>
      <% end %>
    </ul>
  <% end %>

  <%= link_to "Back to neighborhoods",
        neighborhoods_path,
        class: "btn btn-outline-secondary" %>
</div>