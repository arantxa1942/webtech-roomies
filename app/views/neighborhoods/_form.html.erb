<%= form_with model: neighborhood do |form| %>
  <% if neighborhood.errors.any? %>
    <div class="alert alert-danger" role="alert">
      <p class="mb-1">The neighborhood could not be saved:</p>
      <ul class="mb-0">
        <% neighborhood.errors.full_messages.each do |message| %>
          <li><%= message %></li>
        <% end %>
      </ul>
    </div>
  <% end %>

  <div class="mb-3">
    <%= form.label :name, "Neighborhood name", class: "form-label" %>
    <%= form.text_field :name,
          required: true,
          class: "form-control #{invalid_class(neighborhood, :name)}" %>
    <%= field_errors(neighborhood, :name) %>
  </div>

  <div class="mb-3">
    <%= form.label :city, class: "form-label" %>
    <%= form.text_field :city,
          required: true,
          class: "form-control #{invalid_class(neighborhood, :city)}" %>
    <%= field_errors(neighborhood, :city) %>
  </div>

  <%= form.submit class: "btn btn-primary" %>
  <%= link_to "Cancel", neighborhoods_path, class: "btn btn-outline-secondary ms-2" %>
<% end %>