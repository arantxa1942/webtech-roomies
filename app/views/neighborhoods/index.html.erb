<div class="container py-4">
  <div class="d-flex justify-content-between align-items-center mb-4">
    <h1>Neighborhoods</h1>
    <% if policy(Neighborhood).create? %>
      <%= link_to "New neighborhood", new_neighborhood_path, class: "btn btn-primary" %>
    <% end %>
  </div>

  <% if @neighborhoods.empty? %>
    <p>No neighborhoods available.</p>
  <% else %>
    <ul class="list-group">
      <% @neighborhoods.each do |neighborhood| %>
        <li class="list-group-item d-flex justify-content-between align-items-center">
          <%= link_to "#{neighborhood.name}, #{neighborhood.city}",
                neighborhood_path(neighborhood) %>
          <% if policy(neighborhood).update? %>
            <%= link_to "Edit", edit_neighborhood_path(neighborhood),
                  class: "btn btn-sm btn-outline-primary" %>
          <% end %>
        </li>
      <% end %>
    </ul>
  <% end %>
</div>