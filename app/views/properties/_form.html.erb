<%= form_with model: property do |form| %>
  <div class="mb-3">
    <%= form.label :title, class: "form-label" %>
    <%= form.text_field :title, required: true, placeholder: "e.g. Apartment near Manuel Montt",
          class: "form-control #{invalid_class(property, :title)}" %>
    <%= field_errors(property, :title) %>
  </div>

  <div class="mb-3">
    <%= form.label :address, class: "form-label" %>
    <%= form.text_field :address, required: true,
          class: "form-control #{invalid_class(property, :address)}" %>
    <%= field_errors(property, :address) %>
  </div>

  <div class="row">
    <div class="col-md-6 mb-3">
      <%= form.label :neighborhood_id, "Neighborhood", class: "form-label" %>
      <%= form.collection_select :neighborhood_id, Neighborhood.order(:name), :id, :name,
            { prompt: "Select neighborhood" },
            { required: true, class: "form-select #{invalid_class(property, :neighborhood)}" } %>
      <%= field_errors(property, :neighborhood) %>
    </div>

    <div class="col-md-6 mb-3">
      <%= form.label :property_type, "Property type", class: "form-label" %>
      <%= form.select :property_type,
            Property::PROPERTY_TYPES.map { |t| [ t.humanize, t ] },
            { prompt: "Select property type" },
            { class: "form-select #{invalid_class(property, :property_type)}" } %>
      <%= field_errors(property, :property_type) %>
    </div>
  </div>

  <div class="row">
    <div class="col-md-6 mb-3">
      <%= form.label :bedrooms, class: "form-label" %>
      <%= form.number_field :bedrooms, min: 1, step: 1, required: true,
            class: "form-control #{invalid_class(property, :bedrooms)}" %>
      <%= field_errors(property, :bedrooms) %>
    </div>
    <div class="col-md-6 mb-3">
      <%= form.label :bathrooms, class: "form-label" %>
      <%= form.number_field :bathrooms, min: 1, step: 1, required: true,
            class: "form-control #{invalid_class(property, :bathrooms)}" %>
      <%= field_errors(property, :bathrooms) %>
    </div>
  </div>

  <div class="mb-3 form-check">
    <%= form.check_box :shared_spaces, class: "form-check-input" %>
    <%= form.label :shared_spaces, "Shared spaces", class: "form-check-label" %>
  </div>

  <fieldset class="mb-3">
    <legend class="form-label fs-6">Amenities</legend>
    <%= form.collection_check_boxes :amenity_ids, Amenity.order(:category, :name), :id, :name do |b| %>
      <div class="form-check form-check-inline">
        <%= b.check_box(class: "form-check-input") %>
        <%= b.label(class: "form-check-label") %>
      </div>
    <% end %>
  </fieldset>

  <%= form.submit "Save property", class: "btn btn-primary" %>
  <%= link_to "Cancel", properties_path, class: "btn btn-secondary ms-2" %>
<% end %>