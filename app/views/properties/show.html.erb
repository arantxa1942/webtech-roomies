<div class="container py-4">
    <h1 class="mb-3"><%= @property.title %></h1>

    <p><strong>Neighborhood:</strong> <%= @property.neighborhood.name %></p>
    <p><strong>Address:</strong> <%= @property.address %></p>
    <p><strong>Bedrooms:</strong> <%= @property.bedrooms %></p>
    <p><strong>Bathrooms:</strong> <%= @property.bathrooms %></p>
    <p><strong>Shared spaces:</strong> <%= @property.shared_spaces ? "Yes" : "No" %></p>
    <% if @property.description.present? %>
        <p><%= @property.description %></p>
    <% end %>

    <!-- Botones unificados utilizando link_to con clases de Bootstrap para que se vean idénticos -->
    <div class="mt-4 d-flex gap-2 align-items-center">
        <%= link_to "Edit", edit_property_path(@property), class: "btn btn-warning text-dark" %>
        
        <%= link_to "Delete", property_path(@property), data: { turbo_method: :delete, turbo_confirm: "¿Estás seguro de que quieres eliminar esto?" }, class: "btn btn-danger" %>

        <%= link_to "Back to properties", properties_path, class: "btn btn-outline-secondary" %>
    </div>

    <h2 class="h4 mt-4">Listings</h2>
    <% if @property.listings.empty? %>
        <div class="d-flex justify-content-between align-items-center mt-2">
            <p class="mb-0">This property has no listings.</p>
            <%= link_to "New listing", new_listing_path(property_id: @property.id), class: "btn btn-primary btn-sm" %>
        </div>
    <% else %>
        <div class="d-flex justify-content-between align-items-center mt-2 mb-3">
            <span class="text-muted">Listado de habitaciones/espacios</span>
            <%= link_to "New listing", new_listing_path(property_id: @property.id), class: "btn btn-primary btn-sm" %>
        </div>
        <ul>
            <% @property.listings.each do |listing| %>
                <li>
                    <%= link_to listing.title, listing_path(listing) %> - <%= number_to_currency(listing.monthly_rent, unit: "$", precision: 0) %>
                </li>
            <% end %>
        </ul>
    <% end %>

    <h2 class="h4 mt-4">Reviews</h2>
    <% if @property.respond_to?(:reviews) && @property.reviews.any? %>
        <% @property.reviews.each do |review| %>
            <div class="mb-3">
                <h3 class="h6"><%= review.reviewer.full_name %></h3>
                <p>Rating: <%= review.rating %> / 5</p>
                <p><%= review.comment %></p>
            </div>
        <% end %>
    <% else %>
        <p>No reviews yet.</p>
    <% end %>
</div>