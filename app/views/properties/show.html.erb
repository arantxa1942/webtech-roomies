<div class="container py-4">
  <h1 class="mb-3"><%= @property.title %></h1>
  
  <p><strong>Neighborhood:</strong> <%= @property.neighborhood&.name %></p>
  <p><strong>Address:</strong> <%= @property.address %></p>
  <p><strong>Bedrooms:</strong> <%= @property.bedrooms %></p>
  <p><strong>Bathrooms:</strong> <%= @property.bathrooms %></p>
  <p><strong>Shared spaces:</strong> <%= @property.shared_spaces? ? 'Yes' : 'No' %></p>

  <div class="mb-4">
    <%= link_to "Edit", edit_property_path(@property), class: "btn btn-warning me-2" %>
    <%= link_to "Delete", property_path(@property), data: { turbo_method: :delete, turbo_confirm: "Are you sure you want to delete this property?" }, class: "btn btn-danger me-2" %>
    <%= link_to "Back to properties", properties_path, class: "btn btn-secondary" %>
  </div>

  <h2 class="h4 mt-4">Listings</h2>
  <% if @listings.empty? %>
    <p>This property has no listings.</p>
  <% else %>
    <div class="row g-4">
      <!-- Aquí se despliegan los listings si los hay -->
    </div>
  <% end %>

  <h2 class="h4 mt-4">Reviews</h2>
  <% if @reviews.empty? %>
    <p>No reviews yet.</p>
  <% else %>
    <!-- Aquí se despliegan las reviews si las hay -->
  <% end %>
</div>