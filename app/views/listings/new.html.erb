<div class="container py-4">
    <h1 class="mb-4">New Listing</h1>

    <%= form_with(model: @listing, local: true) do |form| %>
        <% if @listing.errors.any? %>
            <div class="alert alert-danger">
                <h4><%= pluralize(@listing.errors.count, "error") %> prohibited this listing from being saved:</h4>
                <ul>
                    <% @listing.errors.full_messages.each do |message| %>
                        <li><%= message %></li>
                    <% end %>
                </ul>
            </div>
        <% end %>

        <!-- Campo oculto para conservar el ID de la propiedad -->
        <%= form.hidden_field :property_id %>

        <div class="mb-3">
            <%= form.label :title, class: "form-label" %>
            <%= form.text_field :title, class: "form-control" %>
        </div>

        <div class="mb-3">
            <%= form.label :monthly_rent, class: "form-label" %>
            <%= form.number_field :monthly_rent, class: "form-control" %>
        </div>

        <div class="mb-3">
            <%= form.label :deposit, class: "form-label" %>
            <%= form.number_field :deposit, class: "form-control" %>
        </div>

        <div class="mb-3">
            <%= form.label :minimum_stay, "Minimum stay (months)", class: "form-label" %>
            <%= form.number_field :minimum_stay, class: "form-control" %>
        </div>

        <div class="mb-3">
            <%= form.label :available_from, class: "form-label" %>
            <%= form.date_field :available_from, class: "form-control" %>
        </div>

<div class="mb-3">
            <%= form.label :description, class: "form-label" %>
            <%= form.text_area :description, rows: 4, class: "form-control" %>
        </div>

        <div class="mb-3">
            <%= form.label :house_rules, class: "form-label" %>
            <%= form.text_area :house_rules, rows: 4, class: "form-control" %>
        </div>
        <div class="mb-3 form-check">
            <%= form.check_box :furnished, class: "form-check-input" %>
            <%= form.label :furnished, class: "form-check-label" %>
        </div>

        <div class="mb-3 form-check">
            <%= form.check_box :private_bathroom, class: "form-check-input" %>
            <%= form.label :private_bathroom, class: "form-check-label" %>
        </div>

        <div class="mb-3">
            <%= form.label :photos, class: "form-label" %>
            <%= form.file_field :photos, multiple: true, class: "form-control" %>
        </div>

<div class="mb-3">
            <%= form.label :status, class: "form-label" %>
            <%= form.select :status, [['Published', 'published'], ['Draft', 'draft'], ['Closed', 'closed']], {}, class: "form-select" %>
        </div>
        <div class="mt-4 d-flex gap-2">
            <%= form.submit "Create Listing", class: "btn btn-primary" %>
            <%= link_to "Cancel", property_path(@listing.property_id), class: "btn btn-outline-secondary" %>
        </div>
    <% end %>
</div>