<div class="col-md-4">
  <article class="card h-100 shadow-sm">
    <% if listing.photos.attached? %>
      <%= image_tag listing.photos.first.variant(:card), class: "card-img-top", alt: "Photo of #{listing.title}", style: "object-fit: cover; height: 200px;" %>
    <% end %>

    <div class="card-body">
      <h2 class="h5 card-title">
        <%= link_to listing.title, listing_path(listing), class: "text-decoration-none" %>
      </h2>

      <p class="mb-1 text-muted small">
        Property: <%= link_to listing.property.title, property_path(listing.property) %>
      </p>
      <p class="mb-1 text-muted small">
        Neighborhood: <%= listing.property.neighborhood.name %>
      </p>
      <p class="mb-1 fw-bold text-primary">
        Monthly rent: <%= number_to_currency(listing.monthly_rent, unit: "$", precision: 0) %>
      </p>
      <p class="mb-0 text-muted small">
        Available from: <%= listing.available_from %>
      </p>
    </div>
  </article>
</div>