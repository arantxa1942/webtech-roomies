  <h2 class="h4">Description</h2>
  <div class="mb-4"><%= @listing.description %></div>

  <h2 class="h4">House rules</h2>
  <% if @listing.house_rules.present? %>
    <div class="mb-4"><%= @listing.house_rules %></div>
  <% else %>
    <p>No house rules specified.</p>
  <% end %>

  <ul class="list-group mb-4">
    <li class="list-group-item"><strong>Monthly rent:</strong> <%= number_to_currency(@listing.monthly_rent, unit: "$", precision: 0) %></li>
    <li class="list-group-item"><strong>Deposit:</strong> <%= @listing.deposit ? number_to_currency(@listing.deposit, unit: "$", precision: 0) : "Not specified" %></li>
    <li class="list-group-item"><strong>Minimum stay:</strong> <%= @listing.minimum_stay ? "#{@listing.minimum_stay} months" : "Not specified" %></li>
    <li class="list-group-item"><strong>Available from:</strong> <%= @listing.available_from %></li>
    <li class="list-group-item"><strong>Status:</strong> <%= @listing.status.humanize %></li>
    <li class="list-group-item"><strong>Furnished:</strong> <%= @listing.furnished ? "Yes" : "No" %></li>
    <li class="list-group-item"><strong>Private bathroom:</strong> <%= @listing.private_bathroom ? "Yes" : "No" %></li>
  </ul>

  <h2 class="h4">Property</h2>
  <p><%= link_to @property.title, property_path(@property) %></p>
  <p>Neighborhood: <%= @property.neighborhood.name %></p>
  <p>Address: <%= @property.address %></p>
  <p>Property type: <%= @property.property_type.presence&.humanize || "Not specified" %></p>
  <p>Bedrooms: <%= @property.bedrooms %></p>
  <p>Bathrooms: <%= @property.bathrooms %></p>
  <p>Shared spaces: <%= @property.shared_spaces ? "Yes" : "No" %></p>

  <h2 class="h4">Amenities</h2>
  <% if @amenities.empty? %>
    <p>No amenities listed.</p>
  <% else %>
    <ul>
      <% @amenities.each do |amenity| %>
        <li><%= amenity.name %></li>
      <% end %>
    </ul>
  <% end %>

  <h2 class="h4">Reviews</h2>
  <% if @reviews.empty? %>
    <p>No reviews yet.</p>
  <% else %>
    <% @reviews.each do |review| %>
      <article class="card mb-3">
        <div class="card-body">
          <h3 class="h6"><%= review.reviewer.full_name %></h3>
          <p>Rating: <%= review.rating %> / 5</p>
          <p><%= review.comment %></p>
        </div>
      </article>
    <% end %>
  <% end %>
  
  <%= link_to "View property and review options", property_path(@property), class: "btn btn-outline-primary mb-4" %>
  <%= render "applications/application_block", listing: @listing, application: @application %>

