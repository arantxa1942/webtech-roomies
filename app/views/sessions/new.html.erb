<div class="row justify-content-center mt-5">
  <div class="col-md-4">
    <h1 class="h3 mb-3 text-center">Sign in</h1>

    <%= form_with url: session_path do |form| %>
      <div class="mb-3">
        <%= form.label :email_address, "Email address", class: "form-label" %>
        <%= form.email_field :email_address, required: true, autofocus: true, class: "form-control" %>
      </div>

      <div class="mb-3">
        <%= form.label :password, class: "form-label" %>
        <%= form.password_field :password, required: true, class: "form-control" %>
      </div>

      <div class="mb-3 d-grid">
        <%= form.submit "Sign in", class: "btn btn-primary" %>
      </div>
    <% end %>
  </div>
</div>